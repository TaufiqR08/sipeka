# =========================================================================
# SIPEKA - Sistem Informasi Pengajuan Cuti & KGB
# Badan Kesatuan Bangsa dan Politik Kabupaten Sumbawa Barat
# =========================================================================

# [1] DATABASE CONFIGURATION (MySQL/MariaDB)
# Local (Laragon/XAMPP): mysql://root:password@localhost:3306/simpeg_kesbangpol
# Production Example: mysql://db_user:strong_password@db_host:3306/simpeg_kesbangpol
DATABASE_URL="mysql://root:@localhost:3306/simpeg_kesbangpol"
# url      = "mysql://bpkadksb_adm:DE%3DRMUkhdR%3DAKWU%23@localhost:3306/bpkadksb_sipeka"

# [2] NEXTAUTH CONFIGURATION (Authentication)
# Di produksi, gunakan URL domain asli (e.g., https://sipeka.sumbawabaratkab.go.id)
NEXTAUTH_URL="http://localhost:3000"
# Buat secret yang kuat menggunakan: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# [3] APPLICATION SETTINGS
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="SIPEKA Kesbangpol KSB"

# [4] FILE UPLOAD SETTINGS
# Lokasi penyimpanan file (Lokal: ./public/uploads)
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE_MB=5

# [5] WHATSAPP GATEWAY (Fonnte)
# Dapatkan token dari https://fonnte.com/
FONNTE_TOKEN="your_fonnte_token_here"
WHATSAPP_SENDER_NAME="SIPEKA NOTIF"

# [6] EMAIL CONFIGURATION (Optional - SMTP)
# Jika ingin mengirim notifikasi via Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@sumbawabaratkab.go.id"

# [7] CLOUD STORAGE (Optional - for Production Assets)
# Jika ingin menggunakan S3/Google Cloud Storage sebagai pengganti local storage
STORAGE_PROVIDER="local" # 'local' or 's3'
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION=""
S3_BUCKET_NAME=""
S3_ENDPOINT="" # Untuk layanan seperti DigitalOcean Spaces/Minio
